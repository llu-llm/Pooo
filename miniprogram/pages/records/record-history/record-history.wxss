.container {
  padding: 30rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  font-size: 28rpx;
  color: #999;
}

.timeline {
  margin-bottom: 40rpx;
}

.date-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.date-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4CAF50;
  margin-right: 16rpx;
}

.date-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #2e7d32;
}

.date-items {
  padding-left: 40rpx;
  border-left: 2rpx solid #d0e8d0;
  margin-left: 8rpx;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.item-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.time {
  font-size: 24rpx;
  color: #4CAF50;
  margin-right: 16rpx;
}

.category {
  font-size: 22rpx;
  color: #fff;
  background: #4CAF50;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.input-icon {
  font-size: 28rpx;
}

.title {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.content {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}