.container {
  padding: 40rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  font-size: 32rpx;
  color: #333;
}

.btn {
  margin-top: 40rpx;
  background: #4CAF50;
  color: #fff;
  border-radius: 12rpx;
  font-size: 34rpx;
}

.result {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.result-item:last-of-type {
  border-bottom: none;
}

.result-label {
  font-size: 30rpx;
  color: #666;
}

.result-value {
  font-size: 34rpx;
  color: #2e7d32;
  font-weight: bold;
}

.disclaimer {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}