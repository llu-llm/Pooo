.container {
  padding: 30rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin: 20rpx 0 30rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2e7d32;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.picker-value {
  font-size: 28rpx;
  color: #4CAF50;
}

.upload-area {
  height: 400rpx;
  background: #fff;
  border: 2rpx dashed #4CAF50;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 100rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #4CAF50;
  margin-top: 20rpx;
}

.preview {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.preview-img {
  width: 100%;
  border-radius: 12rpx;
}

.quality-tip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #ff9800;
  line-height: 1.5;
  text-align: center;
}

.btn-row {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 0 40rpx;
}

.btn-rechoose, .btn-history {
  font-size: 28rpx;
  color: #4CAF50;
  padding: 10rpx 30rpx;
}

.loading {
  text-align: center;
  font-size: 30rpx;
  color: #4CAF50;
  padding: 40rpx 0;
}

.top3 {
  margin-top: 30rpx;
}

.top3-title {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
}

.candidate-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.candidate-item.active {
  border-color: #4CAF50;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}

.candidate-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.candidate-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.candidate-confidence {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
}

.confidence-bar {
  height: 8rpx;
  background: #eee;
  border-radius: 4rpx;
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  background: #4CAF50;
  transition: width 0.3s;
}

.result {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-bottom: 20rpx;
}

.result-block {
  margin-top: 24rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.block-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.disclaimer {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}