.container {
  padding: 30rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin: 20rpx 0 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2e7d32;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.upload-area {
  height: 400rpx;
  background: #fff;
  border: 2rpx dashed #4CAF50;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 100rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #4CAF50;
  margin-top: 20rpx;
}

.preview {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.preview-img {
  width: 100%;
  border-radius: 12rpx;
}

.btn-rechoose {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #4CAF50;
}

.loading {
  text-align: center;
  font-size: 30rpx;
  color: #4CAF50;
  padding: 40rpx 0;
}

.result {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-bottom: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.result-row .label {
  font-size: 28rpx;
  color: #666;
}

.result-row .value {
  font-size: 30rpx;
  color: #2e7d32;
  font-weight: bold;
}

.result-block {
  margin-top: 24rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.block-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.disclaimer {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}