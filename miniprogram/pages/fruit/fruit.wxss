.container {
  padding: 30rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin: 20rpx 0 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2e7d32;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.upload-area {
  height: 400rpx;
  background: #fff;
  border: 2rpx dashed #4CAF50;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 100rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #4CAF50;
  margin-top: 20rpx;
}

.preview {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.preview-img {
  width: 100%;
  border-radius: 12rpx;
}

.btn-rechoose {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #4CAF50;
}

.loading {
  text-align: center;
  font-size: 30rpx;
  color: #4CAF50;
  padding: 40rpx 0;
}

.result {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 30rpx;
  margin-top: 30rpx;
  text-align: center;
}

.count-area {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
}

.count-label {
  font-size: 32rpx;
  color: #666;
  margin-right: 10rpx;
}

.count-num {
  font-size: 100rpx;
  font-weight: bold;
  color: #2e7d32;
  line-height: 1;
  margin: 0 10rpx;
}

.count-unit {
  font-size: 32rpx;
  color: #2e7d32;
}

.box-info {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.box-title {
  font-size: 26rpx;
  color: #999;
}