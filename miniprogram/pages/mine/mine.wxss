.container {
  padding: 30rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.profile {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 30rpx;
}

.nickname {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.userid {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.stats {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.footer {
  text-align: center;
  margin-top: 80rpx;
}

.footer text {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.footer-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #bbb;
}