<view class="container">
  <view class="profile">
    <view class="avatar">👤</view>
    <view class="info">
      <text class="nickname">测试用户</text>
      <text class="userid">ID: test001</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <text class="stat-num">{{stats.disease}}</text>
      <text class="stat-label">识病次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.fruit}}</text>
      <text class="stat-label">数果次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.farm}}</text>
      <text class="stat-label">农事记录</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goKnowledge">
      <text class="menu-icon">📚</text>
      <text class="menu-text">知识库</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showHelp">
      <text class="menu-icon">❓</text>
      <text class="menu-text">帮助与反馈</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="exportData">
      <text class="menu-icon">📤</text>
      <text class="menu-text">数据导出</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer">
    <text>田间诊 V1.0</text>
    <text class="footer-sub">AI农业生产辅助小程序</text>
  </view>
</view>