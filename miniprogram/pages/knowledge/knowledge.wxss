.container {
  padding: 30rpx;
  background: #f5f9f5;
  min-height: 100vh;
}

.search-bar {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
}

.search-bar input {
  font-size: 28rpx;
  color: #333;
}

.list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.item:last-child {
  border-bottom: none;
}

.item-icon {
  font-size: 50rpx;
  margin-right: 24rpx;
}

.item-content {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.item-crop {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.item-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}